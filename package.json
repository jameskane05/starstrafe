{
  "name": "starspeed",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build-lod": "node scripts/build-lod.cjs",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/images/site/icon.png",
    "generate-large-pwa-icons": "node scripts/generate-large-pwa-icons.cjs",
    "dev": "vite",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "server": "npx kill-port 2567 && cd server && npm start",
    "kill-server": "npx kill-port 2567",
    "build": "cd server && npm install && npm run build",
    "build:client": "vite build",
    "preview": "vite preview",
    "deploy:gh": "node scripts/deploy-gh.mjs",
    "deploy:gh:fresh": "node scripts/deploy-gh.mjs --no-history",
    "deploy:server": "cd server && npx @colyseus/cloud deploy --env production"
  },
  "devDependencies": {
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "concurrently": "^9.1.2",
    "gh-pages": "^6.3.0",
    "kill-port": "^2.0.1",
    "lil-gui": "^0.21.0",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.17.25",
    "@dgreenheck/three-pinata": "^2.0.1",
    "@dimforge/rapier3d": "^0.19.0",
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@pixiv/three-vrm": "^3.0.0",
    "@pixiv/three-vrm-animation": "^3.5.0",
    "@sparkjsdev/spark": "2.1.0",
    "howler": "^2.2.4",
    "postprocessing": "^6.38.3",
    "three": "^0.180.0"
  }
}
